# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
EXA_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- Tracing (self-hosted Langfuse, docker compose --profile tracing) ---
# Run scripts/init-env.sh to fill these with random local values.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
